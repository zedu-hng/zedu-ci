# Live settings for zedu-fe PR previews. Read from zedu-ci main when a workflow runs, like teams.yml:
# a change here applies at once, with no caller bump. The public build env is build/zedu-fe.env.
#
# Off switch: previews build and deploy only when this is true. Flip it after the one-time setup.
PREVIEW_ENABLED=true
# Previews are served at https://<PR number>.<PREVIEW_DOMAIN>.
PREVIEW_DOMAIN=preview.groups.zedu.chat
# Backend for previews without a `Backend URL:` override in the PR body: the live backend, so a
# reviewer can reproduce a ticket against the same data. Review with a test account, not a real one.
PREVIEW_BACKEND_HOST=api.zedu.chat
