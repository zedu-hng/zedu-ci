# Public build values for zedu-fe PR previews (pr-checks-node.yml, build_env_file).
# Read at the zedu-ci commit the caller pins, so a change ships with a caller bump.
# NEXT_PUBLIC_* values ship in the browser bundle, so nothing here is secret. Never add a secret.
# API_URL, BASE_URL, CONNECT_URL and CLIENT_URL are derived per preview from the backend host and the
# preview URL. Analytics, push, webhooks and Agora stay unset. Store and social links are the public ones from zedu.chat. Copied from zedu-hng-fe.
NEXT_PUBLIC_MEDIA_URL=https://media.zedu.chat
NEXT_PUBLIC_MEDIA_STAGING_URL=https://minio.groups.zedu.chat
