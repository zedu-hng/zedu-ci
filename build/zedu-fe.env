# Public build values for zedu-fe PR previews (pr-checks-node.yml, build_env_file).
# Read at the zedu-ci commit the caller pins, so a change ships with a caller bump.
# NEXT_PUBLIC_* values ship in the browser bundle, so nothing here is secret. Never add a secret.
# API_URL, BASE_URL, CONNECT_URL and CLIENT_URL are derived per preview from the backend host and the
# preview URL. Analytics, push, webhooks and Agora stay unset. Store and social links are the public
# ones from zedu.chat. The IP, avatar and emoji URLs are the defaults FE hardcoded before its env
# migration (zedu-fe 691686b). Copied from zedu-hng-fe.
NEXT_PUBLIC_MEDIA_URL=https://media.zedu.chat
NEXT_PUBLIC_MEDIA_STAGING_URL=https://minio.groups.zedu.chat
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=net.emerj.zedu
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/ng/app/zedu-app/id6759181591
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61578751079130
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/telex.im
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@telexim
NEXT_PUBLIC_X_URL=https://x.com/teleximapp
NEXT_PUBLIC_IPIFY_URL=https://api.ipify.org?format=json
NEXT_PUBLIC_IPAPI_URL=https://ipapi.co/json/
NEXT_PUBLIC_UI_AVATARS_URL=https://ui-avatars.com/api/
NEXT_PUBLIC_EMOJI_DATASOURCE_URL=https://cdn.jsdelivr.net/npm/emoji-datasource-apple@15.0.1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=764182056638-bi8bet0rdoabaeq24bqsdnb5iukn7ko4.apps.googleusercontent.com
NEXT_PUBLIC_OFFICE_EMBED_URL=https://view.officeapps.live.com/op/embed.aspx
