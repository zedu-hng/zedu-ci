# .env for zedu-desktop PR builds in contributor forks (pr-build-flutter.yml).
# Read at the zedu-ci commit the caller pins, so a change ships with a caller bump.
# Public values only: .env is bundled into the app as an
# asset, so anyone with a build can read it. Never add a secret.
#
# {{backend}} is the API host: api.hng.groups.zedu.chat (the dev backend), or the host from the PR
# body's `Backend URL:` line. Keys match zedu-desktop's .env.example. GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET stay unset: Google sign-in doesn't work in review builds.
API_BASE_URL=https://{{backend}}/api/v1/
USE_MOCK_DATA=false
APP_FLAVOR=development
